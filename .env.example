# Copy to .env.local for local dev. Everything is optional locally.

# Local: SQLite file (default). Cloud: your Neon connection string, e.g.
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/golftour?sslmode=require
DATABASE_URL=file:./data/local.db

# Signs the login cookie. Required in production: openssl rand -base64 32
SESSION_SECRET=

# Public URL used in invite links (falls back to the request host)
APP_URL=http://localhost:3000

# Set to 1 during the real tour to hide Organize → Demo (starting a demo wipes scores)
DEMO_DISABLED=

# Used by `npm run seed`
SEED_EVENT_PASSWORD=tour2026
SEED_ORGANIZER_EMAIL=organizer@example.com
